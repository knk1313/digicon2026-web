---
// ページの下端のフッター。過去の制作展へのリンク（アーカイブ）、クレジット、著作権の表記をまとめる。
// ヘッダーと同じく有孔ボード（main[data-board]）の外、その下に置く。吊らない
const archives = ['2025', '2024', '2023', '2022'];
---

<footer id="archive" class="border-t border-hair bg-panel text-ink">
	<div class="flex flex-wrap gap-x-20 gap-y-8 px-[60px] pt-10 pb-8 max-md:px-[26px]">
		<section aria-labelledby="footer-archive">
			<h2 id="footer-archive" class="font-label text-[12px] font-bold text-mute">アーカイブ</h2>
			<ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-[14px]">
				{archives.map((y) => <li><span>{y}</span></li>)}
			</ul>
		</section>
		<section aria-labelledby="footer-credit">
			<h2 id="footer-credit" class="font-label text-[12px] font-bold text-mute">クレジット</h2>
			<p class="mt-3 text-[14px]">未定</p>
		</section>
	</div>
	<p class="border-t border-hair px-[60px] py-5 font-label text-[12px] text-mute max-md:px-[26px]">
		<!-- ラベルの書体（M PLUS 1 Code）には © がなく、ほかの書体で小さく上に寄って出るので、本文の書体で出す -->
		<span class="font-body">©</span> 2026 筑波大学 情報メディア創成学類 ディジタルコンテンツ表現実習
	</p>
</footer>

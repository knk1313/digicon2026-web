---
// ナビの札。広い画面（1280px 以上）では最初の画面の右上に吊る。
// それより狭いとタイトルの 1 段目と重なるので、ページの最上部の行にする（スマホは「メニュー」だけ）
const items = [
	{ href: '#theme', label: 'コンセプト' },
	{ href: '#works', label: '作品' },
	{ href: '#info', label: 'アクセス' },
	{ href: '#archive', label: 'アーカイブ' },
];
---

<nav aria-label="ページ内の移動" class="plate absolute top-[66px] right-[210px] flex items-center gap-10 px-4 pt-4 pb-2.5 max-xl:hidden" data-hang="0.15,0.85">
	<span class="font-label text-[11px] font-bold tracking-wider">DIGICON 2026</span>
	<ul class="flex gap-7 text-[13px]">
		{items.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
	</ul>
</nav>
<!-- 右上はステートメントのボタンが吊られるので、行は左に寄せる -->
<nav aria-label="ページ内の移動" class="hidden max-xl:flex absolute top-[14px] left-5 md:left-[84px] items-center gap-6 font-label text-[11px] font-bold">
	<span>DIGICON 2026</span>
	<ul class="flex gap-6 font-body font-normal text-[13px] max-md:hidden">
		{items.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
	</ul>
	<a href="#works" class="hidden max-md:inline font-body font-normal text-[13px]">メニュー</a>
</nav>

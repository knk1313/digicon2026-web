---
// ページの上端のヘッダー。ロゴとページ内の移動を横一列に並べる（スマホではロゴと「メニュー」だけ）。
// 有孔ボード（main[data-board]）の外、その上に置くので、ボードの上の座標（タイトルのペグなど）はずれない。
// 右端はステートメントのボタンが画面の上端から吊られるので空けておく
const items = [
	{ href: '#theme', label: 'コンセプト' },
	{ href: '#works', label: '作品' },
	{ href: '#info', label: 'アクセス' },
	{ href: '#archive', label: 'アーカイブ' },
];
---

<header class="border-b border-hair bg-panel text-ink">
	<div class="flex h-14 items-center gap-10 px-[60px] pr-[200px] max-md:gap-6 max-md:px-[26px] max-md:pr-[150px]">
		<a href="#" class="font-label text-[12px] font-bold tracking-wider">DIGICON 2026</a>
		<nav aria-label="ページ内の移動">
			<ul class="flex gap-7 text-[13px] max-md:hidden">
				{items.map((i) => <li><a href={i.href} class="hover:underline">{i.label}</a></li>)}
			</ul>
			<a href="#works" class="hidden text-[13px] max-md:inline">メニュー</a>
		</nav>
	</div>
</header>
